    <script>
        /** 
         * GAME DATA 
         */
        const DATA = {
            clues: {
                'vance_discontent': { id: 'vance_discontent', title: 'Elena\'s Email', desc: 'An email where Elena Vance calls NovaTech "unethical monsters".', found: false },
                'log_spike': { id: 'log_spike', title: 'Server Log', desc: 'A power surge at 03:05 AM in the server room.', found: false },
                'marcus_debt': { id: 'marcus_debt', title: 'Gambling Records', desc: 'Marcus Thorne owes 2 million credits to the Syndicate.', found: false },
                'jax_access': { id: 'jax_access', title: 'Backdoor Entry', desc: 'Jax Miller accessed the AI core via a hidden port.', found: false },
                'chimera_file': { id: 'chimera_file', title: 'Project Chimera', desc: 'Secret file showing NovaTech harvests user brain-waves.', found: false, secret: true },
                'stolen_id': { id: 'stolen_id', title: 'Thorne\'s ID', desc: 'Thorne\'s physical ID card was used during the heist.', found: false }
            },
            suspects: {
                'elena': {
                    name: 'Elena Vance', role: 'Lead Architect', bio: 'Missing since the breach. Brilliant but idealistic.',
                    lines: {
                        initial: "I can't talk long. They are watching the network. I didn't steal it to sell it, Detective.",
                        evidence: "NovaTech isn't building an AI. They're building a cage for the human mind."
                    }
                },
                'marcus': {
                    name: 'Marcus Thorne', role: 'Security Chief', bio: 'Ex-military. Hardline. Claims he was patrolling Sector 4.',
                    lines: {
                        initial: "Vance is our thief. I saw her badge scan into the vault. Simple as that.",
                        evidence: "My debts? Everyone has debts in this city. Doesn't make me a traitor."
                    }
                },
                'jax': {
                    name: 'Jax Miller', role: 'Systems Admin', bio: 'Young, nervous, and knows the system better than anyone.',
                    lines: {
                        initial: "I just do the maintenance! I don't know why the logs were wiped!",
                        evidence: "Okay, fine! I found a backdoor, but I didn't use it for the AI. I was looking for Project Chimera."
                    }
                }
            },
            connections: [
                { a: 'vance_discontent', b: 'jax_access', result: 'Elena and Jax were working together to expose the truth.' },
                { a: 'marcus_debt', b: 'stolen_id', result: 'Marcus likely staged the theft to pay his creditors.' },
                { a: 'jax_access', b: 'chimera_file', result: 'The "theft" was actually an attempt to delete Project Chimera.' }
            ]
        };

        /**
         * GAME ENGINE
         */
        const game = {
            state: {
                currentClues: [],
                linkedConnections: [],
                hints: 3,
                score: 0,
                selectedEvidence: [],
                foundSecret: false
            },

            init() {
                this.checkSave();
                this.updateHUD();
            },

            checkSave() {
                if (localStorage.getItem('cyberDetectiveSave')) {
                    document.getElementById('continue-btn').classList.remove('hidden');
                }
            },

            save() {
                localStorage.setItem('cyberDetectiveSave', JSON.stringify(this.state));
            },

            load() {
                const saved = localStorage.getItem('cyberDetectiveSave');
                if (saved) {
                    this.state = JSON.parse(saved);
                    this.showScreen('game-screen');
                    this.renderEvidence();
                    this.updateHUD();
                }
            },

            startNew() {
                localStorage.removeItem('cyberDetectiveSave');
                this.showScreen('briefing-screen');
            },

            showScreen(id) {
                document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
                document.getElementById(id).classList.remove('hidden');
            },

            showTab(tab) {
                document.querySelectorAll('#main-content > div').forEach(d => d.classList.add('hidden'));
                document.querySelectorAll('.nav-icon').forEach(n => n.classList.remove('active'));
                document.getElementById(`view-${tab}`).classList.remove('hidden');
                
                if(tab === 'interrogation') this.renderSuspects();
                if(tab === 'accuse') this.renderAccusation();
            },

            updateHUD() {
                document.getElementById('clue-count').innerText = this.state.currentClues.length;
                document.getElementById('hint-count').innerText = this.state.hints;
            },

            // --- FILE SYSTEM / PUZZLES ---
            openFile(type) {
                const overlay = document.getElementById('puzzle-overlay');
                const content = document.getElementById('puzzle-content');
                overlay.classList.remove('hidden');

                if (type === 'email') {
                    content.innerHTML = `
                        <h3>Email Archive</h3><br>
                        <p>To: E. Vance | From: Management<br>"Stop questioning the Project Chimera ethics or you will be replaced."</p><br>
                        <button class="btn" onclick="game.collectClue('vance_discontent')">Download Attachment</button>
                        <button class="btn" onclick="game.closePuzzle()">Close</button>
                    `;
                } else if (type === 'logs') {
                    content.innerHTML = `
                        <h3>Security Logs</h3><br>
                        <p>Identify the anomaly:</p>
                        <p>02:50 AM - Thorne Badge - Entry Sector 4</p>
                        <p>03:00 AM - Vance Badge - Entry VAULT</p>
                        <p>03:05 AM - POWER SPIKE - VAULT</p><br>
                        <button class="btn" onclick="game.collectClue('log_spike')">Log Spike Entry</button>
                        <button class="btn" onclick="game.collectClue('stolen_id')">Flag ID Usage</button>
                        <button class="btn" onclick="game.closePuzzle()">Close</button>
                    `;
                } else if (type === 'encrypted') {
                    content.innerHTML = `
                        <h3>Decryption Required</h3><br>
                        <p>Enter the code: (Hint: The time of the power spike)</p>
                        <input type="text" id="pass-input" style="background:#000; color:#0f0; border:1px solid #0f0; padding:10px">
                        <button class="btn" onclick="game.solveEncryption()">Decrypt</button>
                        <button class="btn" onclick="game.closePuzzle()">Close</button>
                    `;
                }
            },

            solveEncryption() {
                const val = document.getElementById('pass-input').value;
                if (val === '0305') {
                    alert("Decryption Successful.");
                    this.collectClue('chimera_file');
                    this.state.foundSecret = true;
                    this.closePuzzle();
                } else {
                    alert("Access Denied.");
                }
            },

            closePuzzle() {
                document.getElementById('puzzle-overlay').classList.add('hidden');
            },

            collectClue(id) {
                if (!this.state.currentClues.includes(id)) {
                    this.state.currentClues.push(id);
                    this.updateHUD();
                    alert("Evidence Collected: " + DATA.clues[id].title);
                }
            },

            // --- EVIDENCE BOARD ---
            renderEvidence() {
                const container = document.getElementById('evidence-display');
                container.innerHTML = '';
                this.state.currentClues.forEach(id => {
                    const c = DATA.clues[id];
                    const div = document.createElement('div');
                    div.className = `evidence-card ${this.state.selectedEvidence.includes(id) ? 'selected' : ''}`;
                    div.innerHTML = `<h4>${c.title}